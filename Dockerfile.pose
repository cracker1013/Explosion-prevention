# 姿勢推定サーバー用Dockerfile
FROM python:3.11-slim

WORKDIR /app

# OpenCV用の依存関係インストール
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Python依存関係
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# アプリケーションコード
COPY server.py .
COPY backend/ ./backend/

EXPOSE 5000

CMD ["python", "server.py"]
