# OpenAI API Key (required for AI review feature)
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Server Ports
POSE_SERVER_PORT=5000
REVIEW_SERVER_PORT=5001
FRONTEND_PORT=5173

# Arduino/MPU Configuration
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200

# Feature Flags
USE_FAKE_OPENAI=false
SIMULATION_MODE=true

# Camera Configuration
CAMERA_INDEX=0
